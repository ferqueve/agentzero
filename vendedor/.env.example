# Copiá este archivo a .env y completá con tus datos reales.
# No subas nunca el archivo .env (ya está en .gitignore).

# Dirección pública de TU billetera en Base (mainnet) donde querés recibir
# los pagos. Creala vos mismo en una wallet real (MetaMask, Coinbase Wallet,
# Rabby, etc.), cambiada a la red Base, y pegá acá solo la dirección pública.
# NO hace falta la clave privada: este servicio solo recibe pagos, nunca los firma.
EVM_ADDRESS=0x5b6557085F603298acfF1E948fD5C9b7e0027d99

# Puerto en el que escucha el servidor (Render lo define automáticamente;
# en local podés dejarlo así).
PORT=4021

# Facilitador x402 a usar. El de abajo es gratuito y no pide cuenta.
# Alternativa si falla: https://facilitator.mogami.tech
FACILITATOR_URL=https://facilitator.mogami.tech